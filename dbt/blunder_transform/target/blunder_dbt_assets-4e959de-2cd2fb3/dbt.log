{"data": {"conn_name": "model.blunder_transform.int_forecast_errors", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "2a21eebb933201f90ef52e8ef9fa6f1e89d6269f12c2e67e1c49296902ba10ba", "node_finished_at": "", "node_name": "int_forecast_errors", "node_path": "intermediate/int_forecast_errors.sql", "node_relation": {"alias": "int_forecast_errors", "database": "memory", "relation_name": "\"memory\".\"main\".\"int_forecast_errors\"", "schema": "main"}, "node_started_at": "2026-08-09T13:25:59.578755", "node_status": "executing", "resource_type": "model", "unique_id": "model.blunder_transform.int_forecast_errors"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.12\", \"profile_name\": \"blunder_transform\", \"target_name\": \"dev\", \"node_id\": \"model.blunder_transform.int_forecast_errors\"} */\n\n  \n  create view \"memory\".\"main\".\"int_forecast_errors__dbt_tmp\" as (\n    select\n    f.point_id,\n    f.valid_date,\n    f.lead_days,\n    f.issued_date,\n    f.temp_max as temp_max_forecast,\n    a.temp_max as temp_max_actual,\n    f.cloud_cover_mean as cloud_cover_forecast,\n    a.cloud_cover_mean as cloud_cover_actual,\n    f.humidity_mean as humidity_forecast,\n    a.humidity_mean as humidity_actual,\n    f.precip_chance as precip_chance_forecast,\n    a.precip_sum as precip_sum_actual\nfrom \"memory\".\"main\".\"stg_forecasts\" f\ninner join \"memory\".\"main\".\"stg_actuals\" a\n    on f.point_id = a.point_id\n    and f.valid_date = a.valid_date\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "0290e524-22be-46bc-b87e-692302533e1b", "level": "debug", "msg": "On model.blunder_transform.int_forecast_errors: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.12\", \"profile_name\": \"blunder_transform\", \"target_name\": \"dev\", \"node_id\": \"model.blunder_transform.int_forecast_errors\"} */\n\n  \n  create view \"memory\".\"main\".\"int_forecast_errors__dbt_tmp\" as (\n    select\n    f.point_id,\n    f.valid_date,\n    f.lead_days,\n    f.issued_date,\n    f.temp_max as temp_max_forecast,\n    a.temp_max as temp_max_actual,\n    f.cloud_cover_mean as cloud_cover_forecast,\n    a.cloud_cover_mean as cloud_cover_actual,\n    f.humidity_mean as humidity_forecast,\n    a.humidity_mean as humidity_actual,\n    f.precip_chance as precip_chance_forecast,\n    a.precip_sum as precip_sum_actual\nfrom \"memory\".\"main\".\"stg_forecasts\" f\ninner join \"memory\".\"main\".\"stg_actuals\" a\n    on f.point_id = a.point_id\n    and f.valid_date = a.valid_date\n  );\n", "name": "SQLQuery", "pid": 335525, "thread": "Thread-1 (worker)", "ts": "2026-08-09T13:25:59.589130Z"}}
